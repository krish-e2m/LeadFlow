# Git ignore rules for LeadFlow Monorepo

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
# The Python build pattern above must not swallow the Next.js source folder.
!apps/web/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.next/
out/
.turbo/

# Environment files (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Docker / Database local data
postgres_data/
redis_data/
docker-compose.override.yml

# Logs
logs/
*.log

# Local test tooling binaries & archives
tools/
*.zip

