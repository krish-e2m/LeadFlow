# ==============================================================================
# LeadFlow Platform Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# --- Global & Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=LeadFlow
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api","web"]

# --- Production only (infra/docker/docker-compose.prod.yml + Caddyfile.prod) ---
# Not read in local dev. See docs/DEPLOYMENT.md. DOMAIN must match the DNS A records you point
# at the VM — Caddy requests Let's Encrypt certs for DOMAIN and api.DOMAIN automatically.
# DOMAIN=yourdomain.com

# --- Security & JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL Database ---
# Note: In production, migrations use POSTGRES_ADMIN_URL, runtime uses DATABASE_URL with RLS
# In production, POSTGRES_PASSWORD and POSTGRES_APP_PASSWORD are *required* to be real values
# (docker-compose.prod.yml refuses to start otherwise) — the dev-only values below are never
# used there; init-db.prod.sh creates the app role with the real POSTGRES_APP_PASSWORD instead
# of the hardcoded one in the dev-only init-db.sql. Generate with: openssl rand -hex 24
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow_admin
POSTGRES_PASSWORD=leadflow_admin_password
POSTGRES_APP_USER=leadflow_app
POSTGRES_APP_PASSWORD=leadflow_app_password

# Full SQLAlchemy Async URLs (used by backend)
# In Docker compose, host is 'postgres'
POSTGRES_ADMIN_URL=postgresql+asyncpg://leadflow_admin:leadflow_admin_password@localhost:5432/leadflow
DATABASE_URL=postgresql+asyncpg://leadflow_app:leadflow_app_password@localhost:5432/leadflow
DATABASE_APP_URL=postgresql+asyncpg://leadflow_app:leadflow_app_password@localhost:5432/leadflow

# --- Redis & ARQ Worker ---
# In Docker compose, host is 'redis'
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Worker Concurrency & Quotas ---
ARQ_MAX_JOBS=20
ARQ_JOB_TIMEOUT=1800
DEFAULT_SEARCH_LEAD_LIMIT=100
MAX_SEARCH_LEAD_LIMIT=500

# ==============================================================================
# External Providers
# ==============================================================================

# --- 1. Hunter.io (Company Discovery, Company Enrichment, Contacts & Deliverability Verification) ---
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
HUNTER_ENABLED=true
HUNTER_AUTO_REVEAL_CONTACTS=false

# --- Inactive / Deprecated: Apollo.io (Retired in favor of Hunter.io) ---
# APOLLO_API_KEY=
# APOLLO_BASE_URL=https://api.apollo.io/v1

# --- 2. OpenRouter (AI Reasoning, Signal Analysis, Outreach Drafts) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_NAME=LeadFlow
OPENROUTER_SITE_URL=https://leadflow.local

# --- 3. HubSpot CRM (works on the FREE HubSpot CRM plan) ---
# Create a Private App in HubSpot (Settings > Integrations > Private Apps) with these scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.companies.read, crm.objects.companies.write
# HUBSPOT_PORTAL_ID is your Hub ID (the number in app.hubspot.com/contacts/<id>/...). It is only
# used to build "Open in HubSpot" links.
# Only standard objects are used (companies, contacts, notes): no custom properties, deals or workflows.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_ENABLED=false

# --- 4. Google PageSpeed Insights API (Website Performance Signals) ---
PAGESPEED_API_KEY=
PAGESPEED_BASE_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed

# --- 5. Google Places API (Local Reputation & Metadata - Gracefully Unconfigured) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false

# --- 6. DataForSEO (SEO, Trust, Backlink Signals - Gracefully Unconfigured) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_ENABLED=false

# --- 7. Resend (Transactional Email, Alerts & Cold Outreach Dispatch) ---
# Create an API key at https://resend.com/api-keys (starts with 're_...')
# Note: For free sandbox testing before verifying your domain, use 'onboarding@resend.dev'
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_ENABLED=true


# --- 8. SuperMemory (Optional Contextual Memory Integration) ---
SUPERMEMORY_API_KEY=
SUPERMEMORY_ENABLED=false

# --- 9. Firecrawl (Deep JS Scraper & LLM Markdown Extraction) ---
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_ENABLED=false

# --- 10. SerpApi (Google Maps, Reviews, Business Reputation) ---
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_ENABLED=false

# --- 11. Google OAuth 2.0 ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ==============================================================================
# Frontend Environment Variables (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=LeadFlow
NEXT_PUBLIC_ENABLE_PORTAL=true
